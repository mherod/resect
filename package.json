{
  "name": "@mherod/resect",
  "version": "1.9.0",
  "description": "Surgical TypeScript/JavaScript module refactoring CLI. Move files, rename exports, and watch every import update automatically.",
  "type": "module",
  "bin": {
    "resect": "./bin/resect.js",
    "resect-mcp": "./bin/resect-mcp.js"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./bun": {
      "bun": "./src/runtime/bun.ts",
      "import": {
        "types": "./dist/runtime/bun.d.ts",
        "default": "./dist/runtime/bun.js"
      }
    },
    "./node": {
      "bun": "./src/runtime/node.ts",
      "import": {
        "types": "./dist/runtime/node.d.ts",
        "default": "./dist/runtime/node.js"
      }
    },
    "./runtime": {
      "bun": "./src/runtime/index.ts",
      "import": {
        "types": "./dist/runtime/index.d.ts",
        "default": "./dist/runtime/index.js"
      }
    }
  },
  "files": [
    "bin/resect.js",
    "bin/resect-mcp.js",
    "src",
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "!**/CLAUDE.md",
    "!**/*.test.ts",
    "!**/*.spec.ts",
    "!**/__fixtures__",
    "!**/__tests__",
    "!**/__test-helpers*",
    "!**/*-test-helpers.*",
    "!**/__tmp_*"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build src/cli.ts src/core/analysis-worker.ts src/commands/mutation-worker.ts --compile --outfile bin/resect-bin && bun build src/mcp-server.ts src/core/analysis-worker.ts src/commands/mutation-worker.ts src/mcp-tools/read-only-worker.ts --compile --outfile bin/resect-mcp-bin",
    "build:mcp": "bun build src/mcp-server.ts src/core/analysis-worker.ts src/commands/mutation-worker.ts src/mcp-tools/read-only-worker.ts --compile --outfile bin/resect-mcp-bin",
    "build:lib": "tsc -p tsconfig.build.json && bun build src/index.ts src/core/analysis-worker.ts src/core/analysis-process-host.ts src/commands/mutation-worker.ts src/runtime/bun.ts src/runtime/node.ts src/runtime/index.ts --outdir dist --target bun --format esm --external typescript --splitting",
    "test": "bun test --timeout=20000",
    "lint": "pnpm exec biome check --write . && pnpm run lint:eslint",
    "lint:eslint": "eslint src --max-warnings 0",
    "typecheck": "pnpm exec tsc --noEmit",
    "verify:size": "bun scripts/check-tarball-size.ts",
    "verify:all": "pnpm run typecheck && pnpm run lint && pnpm test && pnpm run build:lib && pnpm run verify:size",
    "prepublishOnly": "pnpm run verify:all",
    "git:unlock": "rm -f .git/index.lock",
    "check": "pnpm exec biome check --no-errors-on-unmatched .",
    "fix": "pnpm exec biome check --write --no-errors-on-unmatched .",
    "prepare": "[ -d .git ] && husky || true"
  },
  "packageManager": "pnpm@12.13.0+sha512.1e55719bf26e809dce5c5084fdebaa64efb3da9038ae5d68a9f8a68311f1a45841c8c3b76a37298c3b66f6bcc80409a9b7f33c78a7168a3e90fb65a5d8235ae4",
  "keywords": [
    "typescript",
    "javascript",
    "refactoring",
    "cli",
    "move",
    "rename",
    "imports",
    "exports",
    "module",
    "ast",
    "codemod",
    "tsconfig",
    "monorepo"
  ],
  "author": "Matthew Herod",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mherod/resect.git"
  },
  "homepage": "https://github.com/mherod/resect#readme",
  "bugs": {
    "url": "https://github.com/mherod/resect/issues"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "typescript": "^5.7.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.12",
    "@types/bun": "1.3.14",
    "eslint": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "typescript-eslint": "^8.57.2",
    "ultracite": "7.1.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "pnpm exec biome check --write --no-errors-on-unmatched"
    ]
  }
}
